{
  "name": "vite-harmonies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p ./tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest --coverage",
    "ga": "tsx ./src/genetic/main.ts",
    "ga:w": "tsx watch ./src/genetic/main.ts",
    "doc": "typedoc --out docs ./src/index.ts  --tsconfig tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/dom": "^10.4.0",
    "@types/eslint__js": "^8.42.3",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.1",
    "@vitest/ui": "^2.1.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tsdoc": "^0.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^25.0.1",
    "sass": "^1.79.4",
    "tsx": "^4.19.1",
    "typedoc": "^0.26.7",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
