{
  "name": "vite-harmonies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest --coverage",
    "ga": "tsx ./src/genetic/main.ts",
    "ga:w": "tsx watch ./src/genetic/main.ts",
    "doc": "typedoc --out docs ./src/index.ts  --tsconfig tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.4.2",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tsdoc": "^0.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^24.1.1",
    "sass": "^1.77.8",
    "tsx": "^4.17.0",
    "typedoc": "^0.26.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
